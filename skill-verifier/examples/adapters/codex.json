{
  "schema_version": 1,
  "name": "codex",
  "argv": [
    "codex",
    "exec",
    "--skip-git-repo-check",
    "--ephemeral",
    "--ignore-user-config",
    "--sandbox",
    "workspace-write",
    "--json",
    "--output-last-message",
    "{response_file}",
    "-"
  ],
  "response": "file",
  "timeout_seconds": 180,
  "environment": {
    "harness_version": null,
    "model": null,
    "settings": null
  },
  "baseline_isolation": {
    "status": "unverified",
    "evidence": ""
  },
  "filesystem_isolation": {
    "mode": "none"
  },
  "process_environment": {
    "inherit": []
  }
}
